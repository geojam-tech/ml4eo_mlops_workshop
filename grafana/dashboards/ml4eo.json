  "title": "ML4EO \u2014 Vessel Monitoring",
  "uid": "ml4eo-main",
  "editable": true,
  "panels": [
    {
      "id": 20,
      "title": "Pipeline Health",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 21,
      "title": "Setup Status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "description": "Latest outcome of each setup_pipeline step. Run the setup deployment in Prefect to refresh.",
      "targets": [
        {
          "rawQueryText": "SELECT step, status, detail, run_time, ROUND(duration_s, 2) as duration_s FROM setup_status ORDER BY run_time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "generated": {
                        "color": "green",
                        "index": 0
                      },
                      "ok": {
                        "color": "green",
                        "index": 1
                      },
                      "skipped": {
                        "color": "blue",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "detail"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 320
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "title": "Sensor and Model Diagnostics",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 7,
      "title": "Detection Count by Orbit",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT unixepoch(datetime) as time, MAX(CASE WHEN relative_orbit=7 THEN sar_detections END) as \"Orbit 7\", MAX(CASE WHEN relative_orbit=14 THEN sar_detections END) as \"Orbit 14\", MAX(CASE WHEN relative_orbit=80 THEN sar_detections END) as \"Orbit 80\", MAX(CASE WHEN relative_orbit=87 THEN sar_detections END) as \"Orbit 87\" FROM predictions WHERE model_version='$model_version' GROUP BY datetime ORDER BY datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "showPoints": "always",
            "pointSize": 5,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 7"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 14"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "cyan",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 80"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 87"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Detected:AIS Ratio by Orbit",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT unixepoch(datetime) as time, MAX(CASE WHEN relative_orbit=7 THEN detection_ais_ratio END) as \"Orbit 7\", MAX(CASE WHEN relative_orbit=14 THEN detection_ais_ratio END) as \"Orbit 14\", MAX(CASE WHEN relative_orbit=80 THEN detection_ais_ratio END) as \"Orbit 80\", MAX(CASE WHEN relative_orbit=87 THEN detection_ais_ratio END) as \"Orbit 87\" FROM predictions WHERE model_version='$model_version' GROUP BY datetime ORDER BY datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
