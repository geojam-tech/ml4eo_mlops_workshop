              "id": "byName",
              "options": "Orbit 7"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 14"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "cyan",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 80"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Orbit 87"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Orbit Statistics",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT relative_orbit as orbit, COUNT(*) as scenes, ROUND(AVG(sar_detections),1) as avg_detections, ROUND(AVG(detection_ais_ratio),3) as \"avg det:AIS\", ROUND(MIN(detection_ais_ratio),3) as \"min det:AIS\", ROUND(MAX(detection_ais_ratio),3) as \"max det:AIS\" FROM predictions WHERE model_version='$model_version' GROUP BY relative_orbit",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Scenes per month by platform",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "description": "Monthly processed-scene count split by satellite. The Sentinel-1B series collapses to zero after its Dec 2021 failure \u2014 a sensor change, not a change in vessel activity.",
      "targets": [
        {
          "rawQueryText": "SELECT strftime('%Y-%m', datetime) as month, SUM(platform='SENTINEL-1A') as \"Sentinel-1A\", SUM(platform='SENTINEL-1B') as \"Sentinel-1B\" FROM predictions WHERE model_version='$model_version' GROUP BY month ORDER BY month",
          "refId": "A"
        }
      ],
      "options": {
        "stacking": "normal",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100,
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sentinel-1A"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sentinel-1B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 40,
      "title": "Model Tracking",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "id": 1,
      "title": "SAR Detected vs AIS Vessel Counts",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT unixepoch(datetime) as time, sar_detections, ais_count FROM predictions WHERE model_version='$model_version' ORDER BY datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "raw"
        },
        {
          "rawQueryText": "SELECT unixepoch(m.datetime) as time, AVG(m2.sar_detections) as sar_smooth, AVG(m2.ais_count) as ais_smooth FROM predictions m JOIN predictions m2 ON m2.model_version=m.model_version AND m2.datetime BETWEEN datetime(m.datetime,'-30 days') AND m.datetime WHERE m.model_version='$model_version' GROUP BY m.datetime ORDER BY m.datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "smooth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sar_detections"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ais_count"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sar_smooth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ais_smooth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Detected:AIS Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT unixepoch(datetime) as time, detection_ais_ratio FROM predictions WHERE model_version='$model_version' ORDER BY datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "raw"
        },
        {
          "rawQueryText": "SELECT unixepoch(m.datetime) as time, AVG(m2.detection_ais_ratio) as ratio_smooth FROM predictions m JOIN predictions m2 ON m2.model_version=m.model_version AND m2.datetime BETWEEN datetime(m.datetime,'-30 days') AND m.datetime WHERE m.model_version='$model_version' GROUP BY m.datetime ORDER BY m.datetime",
          "timeColumns": [
            "time"
          ],
          "refId": "smooth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "detection_ais_ratio"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ratio_smooth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "Scene Metadata (latest 50)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT thumbnail as preview, datetime, platform, relative_orbit as orbit, sar_detections as detections, ais_count as \"ais (daily)\", ROUND(detection_ais_ratio,3) as ratio, ROUND(coverage_fraction,2) as coverage, flags FROM predictions WHERE model_version='$model_version' AND thumbnail!='' ORDER BY datetime DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "preview"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "image"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coverage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Flags & Alerts (latest 30)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "targets": [
        {
          "rawQueryText": "SELECT datetime, scene_id, flags FROM predictions WHERE model_version='$model_version' AND flags!='' ORDER BY datetime DESC LIMIT 30",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Detected:AIS ratio by calendar month (seasonality)",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "description": "Average detected:AIS ratio per calendar month, all years pooled \u2014 a rough seasonality lens. Winter months tend to pick up ice-driven false positives (an ice-cover proxy).",
      "targets": [
        {
          "rawQueryText": "SELECT CASE strftime('%m', datetime) WHEN '01' THEN 'Jan' WHEN '02' THEN 'Feb' WHEN '03' THEN 'Mar' WHEN '04' THEN 'Apr' WHEN '05' THEN 'May' WHEN '06' THEN 'Jun' WHEN '07' THEN 'Jul' WHEN '08' THEN 'Aug' WHEN '09' THEN 'Sep' WHEN '10' THEN 'Oct' WHEN '11' THEN 'Nov' WHEN '12' THEN 'Dec' END as month, ROUND(AVG(detection_ais_ratio),3) as avg_ratio FROM predictions WHERE model_version='$model_version' AND detection_ais_ratio IS NOT NULL GROUP BY strftime('%m', datetime) ORDER BY strftime('%m', datetime)",
          "refId": "A"
        }
      ],
      "options": {
        "showValue": "auto",
        "xTickLabelRotation": -45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0.5,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 1,
                "color": "yellow"
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        }
      }
    },
    {
      "id": 30,
      "title": "Fleet (AIS-known vessels)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      }
    },
    {
      "id": 31,
      "title": "Vessels seen in the port (top 300 by appearances)",
      "type": "table",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "description": "Per-vessel AIS summary. status: new = first seen after 2022-02-24, left = last seen before it, spanning = both sides.",
      "targets": [
        {
          "rawQueryText": "SELECT shipName as ship, flag, vesselType as type, COUNT(DISTINCT day) as appearances, MIN(day) as first_seen, MAX(day) as last_seen, ROUND(SUM(hours)*1.0/COUNT(DISTINCT day),1) as mean_dwell_h, CASE WHEN MIN(day)>='2022-02-24' THEN 'new' WHEN MAX(day)<'2022-02-24' THEN 'left' ELSE 'spanning' END as status FROM port_vessel_days WHERE site='primorsk' GROUP BY vesselId ORDER BY appearances DESC LIMIT 300",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "new": {
                        "color": "green",
                        "index": 0
                      },
                      "spanning": {
                        "color": "blue",
                        "index": 1
                      },
                      "left": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 32,
      "title": "Flag composition over time (distinct vessels/month)",
      "type": "barchart",
      "gridPos": {
        "h": 11,
        "w": 10,
        "x": 14,
        "y": 52
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ml4eo-sqlite"
      },
      "description": "Distinct vessels per month by flag (top 6 + Other). Watch the flag-of-convenience share (LBR, MHL, MLT, PAN) over the events.",
      "targets": [
        {
          "rawQueryText": "SELECT strftime('%Y-%m', day) as month, COUNT(DISTINCT CASE WHEN flag='RUS' THEN vesselId END) as RUS, COUNT(DISTINCT CASE WHEN flag='LBR' THEN vesselId END) as LBR, COUNT(DISTINCT CASE WHEN flag='MHL' THEN vesselId END) as MHL, COUNT(DISTINCT CASE WHEN flag='PAN' THEN vesselId END) as PAN, COUNT(DISTINCT CASE WHEN flag='MLT' THEN vesselId END) as MLT, COUNT(DISTINCT CASE WHEN flag='GRC' THEN vesselId END) as GRC, COUNT(DISTINCT CASE WHEN flag='GAB' THEN vesselId END) as GAB, COUNT(DISTINCT CASE WHEN flag='COK' THEN vesselId END) as COK, COUNT(DISTINCT CASE WHEN flag NOT IN ('RUS','LBR','MHL','PAN','MLT','GRC','GAB','COK') THEN vesselId END) as Other FROM port_vessel_days WHERE site='primorsk' GROUP BY month ORDER BY month",
          "refId": "A"
        }
      ],
      "options": {
        "stacking": "normal",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100,
        "showValue": "never"
      }
    }
  ],
  "time": {
    "from": "2021-02-01T00:00:00.000Z",
    "to": "2024-03-01T00:00:00.000Z"
  },
  "timezone": "utc",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "model_version",
        "label": "CFAR model",
        "type": "query",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "ml4eo-sqlite"
        },
        "query": "SELECT DISTINCT model_version FROM predictions ORDER BY model_version",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "regex": "",
        "hide": 0
      }
    ]
  }
}